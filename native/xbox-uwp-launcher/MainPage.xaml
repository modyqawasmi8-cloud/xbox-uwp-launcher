<Page
    x:Class="XboxUwpLauncher.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#0B1020"
    FlowDirection="RightToLeft">
    <Grid Padding="56,40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,28">
            <TextBlock
                x:Name="HeaderTitle"
                Text="مشغّل التطبيقات"
                FontSize="38"
                FontWeight="SemiBold"
                Foreground="White" />
            <TextBlock
                Text="اختصارات لتطبيقات UWP التي تدعم روابط التشغيل"
                FontSize="18"
                Foreground="{StaticResource MutedBrush}"
                Margin="0,6,0,0" />
        </StackPanel>

        <Border
            Grid.Row="1"
            Background="{StaticResource PanelBrush}"
            CornerRadius="12"
            Padding="20"
            Margin="0,0,0,24">
            <StackPanel Spacing="12">
                <TextBlock
                    x:Name="FormTitle"
                    Text="إضافة تطبيق"
                    FontSize="22"
                    FontWeight="SemiBold"
                    Foreground="White" />
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="NameInput"
                        Grid.Column="0"
                        Header="اسم التطبيق"
                        PlaceholderText="مثال: تطبيقي"
                        MinHeight="56" />
                    <TextBox
                        x:Name="UriInput"
                        Grid.Column="1"
                        Header="رابط التشغيل (URI)"
                        PlaceholderText="مثال: myapp://open"
                        TextAlignment="Left"
                        FlowDirection="LeftToRight"
                        MinHeight="56" />
                    <Button
                        x:Name="SaveButton"
                        Grid.Column="2"
                        Content="إضافة"
                        Click="SaveEntry_Click"
                        VerticalAlignment="Bottom"
                        MinWidth="132"
                        MinHeight="48"
                        Background="{StaticResource AccentBrush}"
                        Foreground="#07120F" />
                </Grid>
                <Button
                    x:Name="CancelEditButton"
                    Content="إلغاء التعديل"
                    Click="CancelEdit_Click"
                    Visibility="Collapsed"
                    HorizontalAlignment="Left" />
            </StackPanel>
        </Border>

        <ListView
            x:Name="EntriesList"
            Grid.Row="2"
            SelectionMode="None"
            IsItemClickEnabled="False"
            Background="Transparent"
            Padding="0">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border
                        Background="{StaticResource PanelBrush}"
                        CornerRadius="10"
                        Padding="18"
                        Margin="0,0,0,10">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock
                                    Text="{Binding Name}"
                                    FontSize="21"
                                    FontWeight="SemiBold"
                                    Foreground="White" />
                                <TextBlock
                                    Text="{Binding LaunchUri}"
                                    FontSize="14"
                                    Foreground="{StaticResource MutedBrush}"
                                    TextTrimming="CharacterEllipsis"
                                    FlowDirection="LeftToRight"
                                    TextAlignment="Left"
                                    Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button
                                    Content="تشغيل"
                                    Tag="{Binding}"
                                    Click="LaunchEntry_Click"
                                    MinWidth="100"
                                    Background="{StaticResource AccentBrush}"
                                    Foreground="#07120F" />
                                <Button
                                    Content="تعديل"
                                    Tag="{Binding}"
                                    Click="EditEntry_Click"
                                    MinWidth="82" />
                                <Button
                                    Content="حذف"
                                    Tag="{Binding}"
                                    Click="DeleteEntry_Click"
                                    MinWidth="82" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock
            x:Name="EmptyState"
            Grid.Row="2"
            Text="ما أضفت تطبيقات بعد. أدخل اسم التطبيق ورابط URI الذي يوفّره التطبيق."
            TextWrapping="Wrap"
            FontSize="18"
            Foreground="{StaticResource MutedBrush}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MaxWidth="620"
            TextAlignment="Center" />

        <TextBlock
            Grid.Row="3"
            Text="ملاحظة: التشغيل يعتمد على تسجيل التطبيق الهدف لمخطط URI ودعم Xbox له."
            FontSize="14"
            Foreground="{StaticResource MutedBrush}"
            Margin="0,18,0,0" />
    </Grid>
</Page>
