<Application
    x:Class="XboxUwpLauncher.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="AccentBrush" Color="#63E6BE" />
            <SolidColorBrush x:Key="PanelBrush" Color="#171D2B" />
            <SolidColorBrush x:Key="MutedBrush" Color="#AAB4C8" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
